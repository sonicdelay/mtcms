{
  // Runs `npm run fmt` (Prettier, repo-wide, honoring .prettierignore) whenever
  // the mtcms folder is opened in VS Code.
  // Needs "task.allowAutomaticTasks": "on" in .vscode/settings.json to run
  // without the "Allow automatic tasks?" prompt.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prettier fmt",
      "type": "shell",
      "command": "npm",
      "args": ["run", "fmt"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
