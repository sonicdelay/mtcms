# Database provider: "neon" (@neondatabase/serverless) or anything else (pg)
DBPROVIDER=neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# HS256 secret used to sign and verify JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=change-me

# Bootstrap admin credentials used by POST /api/auth when no user node exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Server port (default 4000)
PORT=4000

# Client dev proxy target for /api (used by client/.env, default http://localhost:4000)
# API_TARGET=http://localhost:4000
