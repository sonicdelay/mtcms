{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "dist",
    "types": ["./src/typings/index.d.ts"]
  },

  "include": ["src/**/*.ts", "src/typings/**/*.d.ts"]
}
