{
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [
      "media",
      "dist",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "media",
      "dist",
      "node_modules"
    ]
  },
  "tasks": {
    "dev": "deno run --watch --env-file=../.env --allow-all main.ts",
    "start": "deno run --env-file=../.env --allow-all main.ts",
    "check": "deno check main.ts main_test.ts",
    "test": "deno test --env-file=../.env --allow-all",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
