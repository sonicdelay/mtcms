{
  "name": "mtcms",
  "version": "1.0.0",
  "description": "A content-management web app split into a React client and an Express API server.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "postinstall": "npm run install:client && npm run install:server",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "check": "npm run check:client && npm run check:server",
    "check:client": "npm --prefix client run typecheck",
    "check:server": "npm --prefix server run check",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "verify": "npm run fmt:check && npm run lint && npm run check && npm run test -- --reporter=list --pass-with-no-tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
