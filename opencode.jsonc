      // Babylon.js graph editors. All seven are configured so that switching
      // one on is a one-word change, but only three are enabled: the client
      // renders with `@babylonjs/lite`, and `lite` can consume node materials,
      // node particles, and flow graphs (see ai/rules/babylon-engine.md).
      // It has no GUI, Node Geometry, render-graph, or Smart Filter runtime, so
      // the other four would author assets this app cannot load.
      "babylon-nme": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@babylonjs/mcp-servers@9.32.0",
          "nme"
        ]
      },
      "babylon-npe": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@babylonjs/mcp-servers@9.32.0",
          "npe"
        ]
      },
      "babylon-flow-graph": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@babylonjs/mcp-servers@9.32.0",
          "flow-graph"
        ]
      },
