{
  // mtCMS project configuration for opencode.
  // Schema: https://opencode.ai/config.json
  "$schema": "https://opencode.ai/config.json",
  // Loaded in addition to the built-in AGENTS.md rules.
  "instructions": [
    "ai/PROJECT.md",
    "ai/rules/**/*.md"
  ],
  // Superpowers plugin. OpenCode V1 uses the `plugin` key (plural `plugins`
  // is V2 2.0.4+). Also registered in the global config.
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  // Permissions: allow common safe git commands, ask for anything else.
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny",
      "ai/rules/**/*.md": "deny"
    },
    "bash": {
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "npm run *": "ask",
      "npx *": "ask",
      "node *": "ask",
      "psql *": "ask"
    }
  },
  "exclude": [
    "build",
    "node_modules",
    "media",
    "dist",
    ".backup",
    ".git",
    ".vscode",
    ".idea",
    ".cache",
    ".claude",
    ".next",
    ".fallow",
    ".turbo",
    ".yarn",
    ".pnpm",
    ".gitignore"
  ]
}