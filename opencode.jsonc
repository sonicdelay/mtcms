{
  // mtCMS project configuration for opencode.
  // Schema reference omitted to avoid loading an untrusted remote URL.
  // Schema documentation: https://opencode.ai/config.json
  // Project instructions live in ai/. OpenCode V2 only auto-loads files named
  // `AGENTS.md` (the `instructions` field is accepted but not resolved), so
  // `ai/AGENTS.md` loads when the agent first reads under ai/.
  // Plugins. Superpowers is a package (V2 2.0.4+ key); also registered in the
  // global config. The prettier-fmt plugin lives in ai/ alongside the project's
  // instructions/agents/skills, so its path is registered explicitly: only
  // `.opencode/plugins/` is auto-discovered, not arbitrary locations.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@wakatime/opencode-wakatime"
    //"./ai/plugins/prettier-fmt.js",
  ],
  // MCP servers (V2 shape: servers live under `mcp.servers`). Each entry needs
  // `type: "local"` and `command` as an ARRAY; a string `command` plus `args`
  // fails schema validation and the whole `mcp` key is dropped silently.
  // `command` elements are spawned directly (no shell), so `%USERPROFILE%` and
  // `{env:NAME}` are NOT expanded there — use literal absolute paths, `cwd`,
  // or `{env:NAME}` inside `environment` instead.
  // blender bridges to the ahujasid Blender addon over localhost:9876. The
  // addon must be installed (`uvx mcp-for-blender install-addon`) and Blender
  // must be running with its MCP server started, or tool calls fail.
  "mcp": {
    // First launch resolves and installs the package, which can outrun the
    // 30s default startup budget.
    "timeout": {
      "startup": 120000
    },
    "servers": {
      "blender": {
        "type": "local",
        "command": ["uvx", "--from", "mcp-for-blender", "mcp-for-blender"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      }
    }
  },
  // Project skills. OpenCode discovers `.opencode/skills` automatically, not
  // `ai/skills`, so register the location explicitly.
  "skills": ["./ai/skills"],
  // Custom agents cannot be registered by path: V2's `agents` key must be an
  // object of agent definitions, so a path array fails schema validation and is
  // dropped. Markdown agents are discovered from `.opencode/agents/*.md`
  // instead (see `.opencode/agents/reviewer.md`).
  // Default free model provided by OpenCode Zen (opencode provider).
  "model": "opencode/big-pickle",
  // Format files OpenCode writes or edits, using Prettier (the repo's formatter).
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".md"
      ]
    }
  },
  // Permissions (V2): ordered rules, last match wins. The built-in base policy
  // allows everything, so the broad `shell` ask re-establishes "ask before
  // running commands"; the git rules below allow routine inspection.
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "ai/rules/*.md",
      "effect": "allow"
    },
    {
      "action": "supermemory_recall",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run fmt *",
      "effect": "allow"
    }
  ],
  "exclude": [
    "build",
    "node_modules",
    "media",
    "dist",
    ".backup",
    ".git",
    ".vscode",
    ".idea",
    ".cache",
    ".next",
    ".fallow",
    ".turbo",
    ".yarn",
    ".pnpm",
    ".gitignore",
    "spectre"
  ]
}
