      "effect": "allow"
    }
  ],
  // Filesystem watch exclusions. The schema has no `exclude` key
  // (`additionalProperties: false`), so the previous top-level `exclude` array
  // was dropped at load and did nothing. `watcher.ignore` is the supported
  // key; it stops churn from dependency and build trees.
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/.cache/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/.yarn/**",
      "**/.pnpm/**",
      "**/.fallow/**",
      "**/.backup/**",
      "**/.idea/**",
      "**/.vscode/**",
      "**/coverage/**",
      "**/logs/**",
      "**/3rd-party/**"
    ]
  }
}