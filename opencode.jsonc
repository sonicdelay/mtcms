{
  // mtCMS project configuration for opencode.
  // Schema: https://opencode.ai/config.json
  "$schema": "https://opencode.ai/config.json",

  // Loaded in addition to the built-in AGENTS.md rules.
  "instructions": ["ai/PROJECT.md"],

  // Permissions: allow common safe git commands, ask for anything else.
  "permission": {
    "bash": {
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "npm run *": "ask",
      "npx *": "ask",
      "node *": "ask",
      "psql *": "ask"
    }
  },
  "exclude": [
    "node_modules",
    "media",
    "dist",
    ".backup",
    ".git",
    ".vscode",
    ".idea",
    ".cache",
    ".opencode"
  ]
}
